{
  "name": "@sparerunner/api-codegen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../openapi.yaml --output ../../web/src/api/generated/schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "brace-expansion": "5.0.8",
      "js-yaml": "4.3.0"
    }
  }
}
