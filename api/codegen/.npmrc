# Every install in this repository runs as `pnpm --dir api/codegen ...`, and pnpm
# reads the .npmrc of the directory it installs in. Without a pnpm workspace it
# never walks up to the repository root, so these settings have to live here to
# take effect at all. See the root .npmrc for the same policy stated once.
engine-strict=true
minimum-release-age=1440
strict-peer-dependencies=true
