# Source of truth for this repository's npm supply-chain policy.
#
# pnpm reads the .npmrc of the directory it installs in, and every install here
# runs as `pnpm --dir <project>`. Without a pnpm workspace, pnpm never walks up
# to this file, so web/.npmrc and api/codegen/.npmrc repeat the enforced keys.
# scripts/check-npm-policy.sh fails closed if they ever drift from this file.
#
# minimum-release-age quarantines a freshly published version for 24 hours, which
# is the window in which a compromised publish is usually caught and yanked.
engine-strict=true
minimum-release-age=1440
prefer-workspace-packages=true
strict-peer-dependencies=true
