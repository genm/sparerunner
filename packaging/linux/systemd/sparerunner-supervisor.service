[Unit]
Description=SpareRunner privileged native runner supervisor
Documentation=https://github.com/genm/sparerunner
ConditionPathIsDirectory=/sys/fs/cgroup
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=root
# Delegate= changes the service cgroup ownership to the service user and group.
# Keep both root-owned so the Supervisor can reject a replaced cgroup boundary;
# tmpfiles owns the separate local socket directory for the Agent group.
Group=root
ExecStart=/usr/bin/sparerunner-agent supervisor \
    --socket=/run/sparerunner-supervisor/supervisor.sock \
    --runtime-root=/var/lib/sparerunner-runtime \
    --cache-root=/var/cache/sparerunner-agent \
    --fence-root=/var/lib/sparerunner-supervisor/fences \
    --runner-user=sparerunner-runner-0 \
    --agent-user=sparerunner-agent
Restart=on-failure
RestartSec=5s
KillMode=control-group
# In-process ambiguous-session cleanup is bounded at 20s; systemd owns the
# outer service cgroup and gets a separate margin to complete final teardown.
TimeoutStopSec=30s
Delegate=yes

# The Supervisor has no remote listener and accepts only the fixed local
# protocol from the kernel-authenticated sparerunner-agent UID. These are the
# capabilities needed for slot ownership and complete cgroup cleanup.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes

# These restrictions are inherited by the trusted native workflow. They reduce
# accidental host exposure but are not a hostile-code sandbox.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=no
ProtectProc=invisible
ProcSubset=all
ReadWritePaths=/var/lib/sparerunner-supervisor /var/lib/sparerunner-runtime
UMask=0077

[Install]
WantedBy=multi-user.target
